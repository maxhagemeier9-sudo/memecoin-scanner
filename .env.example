# Optional seit dem Wechsel auf GeckoTerminal/Helius (Birdeye-Kontingent
# erschoepft) - wird noch von filters.py/scanner.py/new_coins.py genutzt.
BIRDEYE_API_KEY=your_api_key_here

# Erforderlich: kostenloser RPC-Endpoint, ersetzt den oeffentlichen Solana-RPC
# (bessere Rate-Limits fuer getTokenLargestAccounts). Signup: dashboard.helius.dev
HELIUS_API_KEY=your_helius_api_key_here

# Optional - fuer Telegram-Alerts im Monitor-Modus (monitor.py). Ohne diese
# beiden Werte funktioniert alles weiter, nur ohne Telegram-Versand.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
